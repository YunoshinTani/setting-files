{
  // 編集・自動保存・ビルド動作を共有。テーマ・フォント・PDF表示・AIは個人設定。
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  // 新規ファイルはスペース2個。既存ファイルのインデントは自動判定する。
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.linkedEditing": true,
  "editor.autoIndentOnPaste": true,
  "editor.autoIndentOnPasteWithinString": false,
  "editor.renderWhitespace": "all",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.unicodeHighlight.allowedLocales": { "ja": true },
  "editor.unicodeHighlight.allowedCharacters": { "，": true, "．": true },
  "editor.quickSuggestions": {
    "other": "on", "comments": "off", "strings": "off"
  },
  // 文書は手書きの改行・字下げを保持し、自動整形しない。
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "[tex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[latex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[bibtex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": "off", "comments": "off", "strings": "off"
    }
  },

  // 全員が .latexmkrc の engine を使う。古い !TeX program 等の迂回を防ぐ。
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.build.rootfileInStatus": true,
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%DIR%/export",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  // 個人のシェル設定ではなく、Windowsでのビルド再現性のために共有する。
  "terminal.integrated.env.windows": { "TEXLIVE_WINDOWS_TRY_EXTERNAL_PERL": "0" },
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-project",
      "command": "latexmk",
      "env": { "TEXLIVE_WINDOWS_TRY_EXTERNAL_PERL": "0" },
      "args": ["-norc", "-r", "%DIR%/.latexmkrc", "-cd", "-outdir=%OUTDIR%", "%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (project)", "tools": ["latexmk-project"] }
  ],
  "latex-workshop.latex.clean.method": "command",
  "latex-workshop.latex.clean.command": "latexmk",
  "latex-workshop.latex.clean.args": [
    "-norc", "-r", "%DIR%/.latexmkrc", "-cd", "-outdir=%OUTDIR%", "-c", "%TEX%"
  ],
  "latex-workshop.latex.autoClean.run": "never",

  // 拡張子のないビルド設定を適切な言語で開く。
  "files.associations": {
    ".latexmkrc": "perl",
    "LICENSE": "plaintext"
  },
  "files.exclude": { ".git": true, ".cache": true },
  // 単独レポート向け。ルート直下の出力・設定だけを除外する。
  // 複数文書を親フォルダで開く場合は、説明書に従って除外範囲を変更する。
  "search.exclude": {
    ".vscode/**": true,
    "*.code-workspace": true,
    ".editorconfig": true,
    ".gitignore": true,
    ".gitattributes": true,
    ".cache/**": true,
    ".latexmkrc": true,
    "export/**": true
  },
  "files.watcherExclude": { "export/**": true },

  "cSpell.words": [
    "arraystretch", "baselinestretch", "begingroup", "bfseries", "endgroup",
    "expdate", "footnoterule", "footnotesize", "makeatletter", "makeatother",
    "maketitle", "multicolumn", "newcommand", "providecommand", "renewcommand",
    "setcounter", "shortstack", "titlepage"
  ]
}
