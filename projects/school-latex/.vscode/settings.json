{
  // 編集・自動保存・ビルド動作を共有。テーマ・フォント・PDF表示・AIは個人設定。
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  // 自動保存の待ち時間・個人設定によらず、タスク開始前に保存する。
  "task.saveBeforeRun": "always",

  // 新規ファイルはスペース2個。既存ファイルのインデントは自動判定する。
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.linkedEditing": true,
  "editor.autoIndentOnPaste": true,
  "editor.autoIndentOnPasteWithinString": false,
  "editor.renderWhitespace": "all",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.unicodeHighlight.allowedLocales": { "ja": true },
  "editor.unicodeHighlight.allowedCharacters": { "，": true, "．": true },
  "editor.quickSuggestions": {
    "other": "on", "comments": "off", "strings": "off"
  },
  // 文書は手書きの改行・字下げを保持し、自動整形しない。
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "[tex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[latex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[bibtex]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": "off", "comments": "off", "strings": "off"
    }
  },

  // 共通ビルドがTeX先頭のエンジン指定を読み、latexmkで文献・再実行を管理する。
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.build.rootfileInStatus": true,
  "latex-workshop.latex.build.enableMagicComments": false,
  // 個人設定の外部ビルドコマンドで共有レシピを迂回しない。
  "latex-workshop.latex.external.build.command": "",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%DIR%/export",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  // 個人のシェル設定ではなく、Windowsでのビルド再現性のために共有する。
  "terminal.integrated.env.windows": { "TEXLIVE_WINDOWS_TRY_EXTERNAL_PERL": "0" },
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-project",
      "command": "texlua",
      // --engine=auto により、保存時ビルドも個人の環境変数に依存しない。
      "env": { "TEXLIVE_WINDOWS_TRY_EXTERNAL_PERL": "0", "LATEX_ENGINE": "" },
      "args": ["%WORKSPACE_FOLDER%/scripts/build.lua", "--engine=auto", "%DOC_EXT%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (project)", "tools": ["latexmk-project"] }
  ],
  "latex-workshop.latex.clean.method": "command",
  "latex-workshop.latex.clean.command": "texlua",
  "latex-workshop.latex.clean.args": [
    "%WORKSPACE_FOLDER%/scripts/build.lua", "--engine=auto", "--clean", "%TEX%"
  ],
  "latex-workshop.latex.autoClean.run": "never",

  "git.autofetch": true,
  // コピー先の親フォルダにある別のリポジトリを自動で開かない。
  "git.openRepositoryInParentFolders": "never",

  // 拡張子のないビルド設定を適切な言語で開く。
  "files.associations": {
    ".latexmkrc": "perl",
    "latexmkrc": "perl",
    "LICENSE": "plaintext"
  },
  "files.exclude": { ".git": true, ".cache": true },
  // 各レポートの出力と、任意で追加した個別ビルド設定を検索から除外する。
  "search.exclude": {
    ".vscode/**": true,
    "*.code-workspace": true,
    ".editorconfig": true,
    ".gitignore": true,
    ".gitattributes": true,
    ".cache/**": true,
    "**/.latexmkrc": true,
    "**/export/**": true
  },
  "files.watcherExclude": { ".cache/**": true, "**/export/**": true },

  "cSpell.words": [
    "arraystretch", "baselinestretch", "begingroup", "bfseries", "endgroup",
    "expdate", "footnoterule", "footnotesize", "makeatletter", "makeatother",
    "maketitle", "multicolumn", "newcommand", "providecommand", "renewcommand",
    "setcounter", "shortstack", "titlepage"
  ]
}
