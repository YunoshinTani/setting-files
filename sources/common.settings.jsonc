{
  // 全プロファイル共通。変更後は配布用・このPC用をそれぞれ再生成する。
  "files.encoding": "utf8",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  // 既存ファイルは自動判定。新規・判定不能時はスペース2個。
  "editor.detectIndentation": true,
  "editor.linkedEditing": true,
  "editor.autoIndentOnPaste": true,
  "editor.autoIndentOnPasteWithinString": false,
  "editor.cursorBlinking": "solid",
  "editor.renderWhitespace": "all",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.unicodeHighlight.allowedLocales": { "ja": true },
  // 80文字の目安線はC/C++だけ。整形ツールの有効化は各プロファイルで行う。
  "[c]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.rulers": [80]
  },
  "[cpp]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.rulers": [80]
  },
  "editor.fontFamily": "'Fira Code', 'FiraCode Nerd Font Mono', monospace",
  "editor.fontLigatures": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.minimap.enabled": false,

  // 整形は言語別に有効化する。
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.activityBar.compact": true,
  "workbench.tree.expandMode": "doubleClick",
  "explorer.sortOrder": "type",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "task.saveBeforeRun": "always",
  "window.confirmSaveUntitledWorkspace": false,

  // 一覧ではルート直下のキャッシュと生成DBを隠す。設定ファイルは表示する。
  "files.exclude": {
    ".cache": true,
    "compile_commands.json": true
  },
  // 通常検索はコード中心。設定を検索するときは検索欄の除外設定を一時解除する。
  "search.exclude": {
    ".vscode/**": true,
    "*.code-workspace": true,
    ".editorconfig": true,
    ".gitignore": true,
    ".gitattributes": true,
    ".clangd": true,
    ".clang-format": true,
    ".clang-tidy": true,
    ".latexmkrc": true,
    "platformio.ini": true
  },

  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": { "source": "PowerShell", "icon": "terminal-powershell" },
    "Command Prompt": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "icon": "terminal-cmd"
    },
    "Git Bash": { "source": "Git Bash", "icon": "terminal-git-bash" }
  },
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "terminal.integrated.suggest.insertTrailingSpace": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "on"
  },

  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": "off",
      "comments": "off",
      "strings": "off"
    }
  },

  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor"
  },
  "codesnap.shutterAction": "copy",
  "workbench.browser.searchEngine": "google",
  "security.workspace.trust.untrustedFiles": "open",
  "settingsSync.ignoredSettings": ["-window.zoomLevel"]
}
